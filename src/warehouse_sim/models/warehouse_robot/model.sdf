<?xml version="1.0"?>
<!-- Group 22 warehouse robot: round diff-drive base (/cmd_vel -> /odom),
     360 deg 2D lidar (/scan), RGB camera (/camera/image_raw),
     thermal camera (/thermal/image_raw).
     Body: cylinder r 0.18, 0.06-0.17 m above ground. Wheels r 0.08,
     separation 0.34. Lidar scan plane at z = 0.21 m (below the 0.3 m
     rack bases). Model origin = base_link, on the ground between the wheels. -->
<sdf version="1.9">
  <model name="warehouse_robot">

    <link name="chassis">
      <pose>0 0 0.115 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0182</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0182</iyy><iyz>0</iyz>
          <izz>0.0324</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.18</radius><length>0.11</length></cylinder></geometry>
      </collision>
      <visual name="body">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.11</length></cylinder></geometry>
        <material>
          <ambient>0.92 0.92 0.9 1</ambient>
          <diffuse>0.92 0.92 0.9 1</diffuse>
        </material>
      </visual>
      <visual name="accent_ring">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.182</radius><length>0.015</length></cylinder></geometry>
        <material>
          <ambient>0.0 0.6 0.65 1</ambient>
          <diffuse>0.0 0.6 0.65 1</diffuse>
        </material>
      </visual>
      <visual name="top_plate">
        <pose>0 0 0.056 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1</ambient>
          <diffuse>0.12 0.12 0.13 1</diffuse>
        </material>
      </visual>
      <visual name="sensor_bar">
        <pose>0.165 0 0.015 0 0 0</pose>
        <geometry><box><size>0.03 0.14 0.04</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1</ambient>
          <diffuse>0.12 0.12 0.13 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0.04 0.17 0.08 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00052</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00052</iyy><iyz>0</iyz>
          <izz>0.00096</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="tyre">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0.04 -0.17 0.08 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00052</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00052</iyy><iyz>0</iyz>
          <izz>0.00096</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="tyre">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rear caster: frictionless sphere so it just slides -->
    <link name="caster">
      <pose>-0.13 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>6.4e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>6.4e-05</iyy><iyz>0</iyz>
          <izz>6.4e-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0</mu><mu2>0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1</ambient>
          <diffuse>0.12 0.12 0.13 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="lidar_link">
      <pose>0 0 0.21 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.045</radius><length>0.08</length></cylinder></geometry>
      </collision>
      <visual name="body">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.08</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.12 0.13 1</ambient>
          <diffuse>0.12 0.12 0.13 1</diffuse>
        </material>
      </visual>
      <visual name="window">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.046</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.0 0.6 0.65 1</ambient>
          <diffuse>0.0 0.6 0.65 1</diffuse>
          <emissive>0.0 0.6 0.65 1</emissive>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- RGB and thermal cameras sit in the front sensor bar,
         below the lidar plane so they do not block the scan -->
    <link name="camera_link">
      <pose>0.185 0.04 0.13 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-05</iyy><iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <visual name="lens">
        <pose>0.005 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
      <sensor name="rgb_camera" type="camera">
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <link name="thermal_link">
      <pose>0.185 -0.04 0.13 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-05</iyy><iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <visual name="lens">
        <pose>0.005 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.5 0.1 0.0 1</ambient>
          <diffuse>0.5 0.1 0.0 1</diffuse>
        </material>
      </visual>
      <!-- Objects get a temperature with the gz-sim-thermal-system plugin;
           everything else reads as ambient. 8-bit output, 3 K per grey level. -->
      <sensor name="thermal_camera" type="thermal">
        <topic>thermal/image_raw</topic>
        <gz_frame_id>thermal_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20</far>
          </clip>
        </camera>
        <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
          <min_temp>253.15</min_temp>
          <max_temp>673.15</max_temp>
          <resolution>3.0</resolution>
        </plugin>
      </sensor>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
      </axis>
    </joint>

    <joint name="caster_joint" type="ball">
      <parent>chassis</parent>
      <child>caster</child>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>chassis</parent>
      <child>lidar_link</child>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent>chassis</parent>
      <child>camera_link</child>
    </joint>

    <joint name="thermal_joint" type="fixed">
      <parent>chassis</parent>
      <child>thermal_link</child>
    </joint>

    <!-- Listens on /cmd_vel, publishes /odom and odom->base_link on /tf. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
    </plugin>
  </model>
</sdf>
